@startuml C4_Container_MediLink
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Container View [C4 Level 2] - Nền tảng MediLink Architecture v2 (Ánh xạ 1:1 với Docker Compose & src/)

Person(patient, "Bệnh nhân", "Web / Mobile Client")
Person(staff, "Bác sĩ / Lễ tân / Ban Giám đốc", "Clinic Portal Client")

System_Boundary(medilink_sys, "MediLink Platform Boundary") {

    Boundary(tb_app, "Application Execution Zone (app-net)", "Trust Boundary A") {
        Container(core_api, "MediLink Core API (medilink-core)", "Node.js 22 LTS, Modular Monolith (src/core/)", "Cung cấp REST API, Token Bucket Rate Limiter, JWT Auth, Contextual ABAC + Consent, Booking Concurrency, EHR AES-256-GCM và Anti-Corruption Layer [Port 3000].")
        Container(bg_worker, "Background Worker (medilink-worker)", "Node.js 22 LTS Process (src/worker/)", "Thực thi 3 tiến trình nền: (1) OutboxSyncWorker có Jitter, (2) NotificationQueueWorker có Exponential Backoff, (3) AuditIntegrityWorker quét chuỗi HMAC.")
    }

    Boundary(tb_data, "Isolated Persistence & Key Zone (data-net - internal: true, không lộ cổng Internet)", "Trust Boundary B") {
        ContainerDb(redis_lock, "Distributed Lock & Fencing Store (redis)", "Redis 7 Alpine (AOF Persistence)", "Cấp khóa phân tán nguyên tử SET NX PX 3000 kèm Monotonic Fencing Token cho slot khám [TCP 6379].")
        ContainerDb(sqlite_db, "Relational Database & Audit Store", "SQLite 3 WAL Engine (src/core/db/database.js)", "Lưu Users, MPI Mappings, Consents, Slots, Bookings [UNIQUE(active_slot_key)], Encrypted Medical Records, Append-Only Audit Logs [Trigger + HMAC], Outbox & Notification Queue.")
        ContainerDb(obj_store, "Encrypted Lab Object Storage", "Isolated File/S3 Bucket (src/core/ehr/labStorageService.js)", "Lưu trữ file PDF xét nghiệm & ảnh chẩn đoán mã hóa nhị phân AES-256-GCM; chỉ truy cập qua Pre-signed URL ngắn hạn (TTL 120s).")
    }
}

Boundary(tb_ext_his, "External Heterogeneous HIS Zone (his-net)", "Trust Boundary C") {
    System_Ext(mock_dn, "Mock HIS Đà Nẵng (mock-his-danang)", "REST / JSON API [Port 8001]")
    System_Ext(mock_hue, "Mock HIS Huế (mock-his-hue)", "Legacy SOAP 1.1 / XML [Port 8002]")
    System_Ext(mock_qn, "Mock HIS Quảng Nam (mock-his-quangnam)", "Legacy Custom RPC/JSON [Port 8003]")
}

System_Ext(notif_gw, "Cổng SMS / Zalo ZNS / Email", "External Messaging API")

Rel(patient, core_api, "Đặt lịch, quản lý Consent, xem EHR & tải PDF", "HTTPS / JSON + Bearer JWT + X-Idempotency-Key")
Rel(staff, core_api, "Check-in cơ sở, khám bệnh, xem Dashboard, kiểm định Audit", "HTTPS / JSON + Bearer JWT")

Rel(core_api, redis_lock, "Acquire/Release Slot Lock + INCR Fencing Token (Sync)", "Redis RESP TCP 6379")
Rel(core_api, sqlite_db, "Giao dịch ACID, ghi Outbox/Queue, ghi Append-Only Audit (Sync)", "SQLite Native C++ Binding (WAL)")
Rel(core_api, obj_store, "Mã hóa lưu file & đọc giải mã qua Pre-signed URL (Sync)", "Encrypted File I/O")

Rel(core_api, mock_dn, "Đồng bộ lịch trực tiếp khi mạch CLOSED (Timeout 1.5s)", "HTTP POST JSON / Port 8001")
Rel(core_api, mock_hue, "Đồng bộ lịch qua SOAP XML khi mạch CLOSED (Timeout 1.5s)", "HTTP POST XML / Port 8002")
Rel(core_api, mock_qn, "Đồng bộ lịch qua Custom RPC khi mạch CLOSED (Timeout 1.5s)", "HTTP POST JSON / Port 8003")

Rel(bg_worker, sqlite_db, "Đọc Outbox/Notification Queue & quét kiểm định HMAC Chain (Async Poll)", "SQLite WAL Shared Volume")
Rel(bg_worker, mock_hue, "Đồng bộ bù lịch hẹn với Rate-Limit + Jitter khi HIS phục hồi (Async)", "HTTP SOAP/REST")
Rel(bg_worker, notif_gw, "Gửi SMS/Zalo/Email kèm Retry Backoff (Async)", "HTTPS REST")

SHOW_LEGEND()
@enduml
