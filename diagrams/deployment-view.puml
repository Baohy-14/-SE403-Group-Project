@startuml Deployment_View_MediLink
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-Deployment.puml

LAYOUT_WITH_LEGEND()

title Deployment View - Hạ tầng Docker Compose Chuẩn hóa (Khớp 100% với `docker-compose.yml`)

Deployment_Node(client_zone, "Untrusted Client Devices", "Internet / Clinic Wi-Fi") {
    Deployment_Node(client_runtime, "Web Browser / Mobile App / Test Runner") {
        Container(client_ui, "MediLink Client", "HTTPS / Fetch Client", "Gửi yêu cầu đặt lịch, tra cứu EHR, quản trị hệ thống")
    }
}

Deployment_Node(docker_host, "MediLink Host Server (Linux Production / Windows Docker Engine)", "Docker Compose v2") {

    Deployment_Node(net_app, "app-net (Bridge Network)", "Application Tier") {
        Deployment_Node(c_core, "Container: medilink-core", "node:22-alpine") {
            Container(app_core, "core/server.js", "Node.js 22 LTS", "Modular Monolith API + Rate Limiter + ACL [Exposed Port 3000:3000]")
        }
        Deployment_Node(c_worker, "Container: medilink-worker", "node:22-alpine") {
            Container(app_worker, "worker/backgroundWorker.js", "Node.js 22 LTS", "Outbox Rate-Controlled Sync + Notification Worker + Audit Verifier")
        }
    }

    Deployment_Node(net_data, "data-net (Internal Bridge: internal = true)", "Isolated Data Tier - Không kết nối Internet") {
        Deployment_Node(c_redis, "Container: medilink-redis", "redis:7-alpine") {
            ContainerDb(db_redis, "Redis Server (AOF everysec)", "Port 6379 (Internal Only)", "Distributed Locks & Monotonic Fencing Counter")
        }
        Deployment_Node(vol_storage, "Shared Volume: medilink_storage (/data)", "Encrypted Persistent Volume") {
            ContainerDb(db_sqlite, "medilink.db (SQLite WAL)", "RDBMS File", "Bookings UNIQUE, Encrypted EHR, Append-Only Audit Logs, Outbox/Queue")
            ContainerDb(bucket_lab, "/data/lab-files/*.enc", "Object Storage Bucket", "Encrypted Lab PDF & Imaging Blobs")
        }
    }

    Deployment_Node(net_his, "his-net (Bridge Network)", "Simulated Clinic Legacy HIS Subnet") {
        Deployment_Node(c_dn, "Container: mock-his-danang", "node:22-alpine") {
            Container(his_dn, "hisDaNangServer.js", "Port 8001", "Mock HIS Đà Nẵng [REST / JSON]")
        }
        Deployment_Node(c_hue, "Container: mock-his-hue", "node:22-alpine") {
            Container(his_hue, "hisHueServer.js", "Port 8002", "Mock HIS Huế [SOAP 1.1 / XML + Chaos Mode]")
        }
        Deployment_Node(c_qn, "Container: mock-his-quangnam", "node:22-alpine") {
            Container(his_qn, "hisQuangNamServer.js", "Port 8003", "Mock HIS Quảng Nam [Custom RPC / JSON]")
        }
    }
}

Rel(client_ui, app_core, "REST API Calls", "HTTPS/HTTP Port 3000")
Rel(app_core, db_redis, "SET NX PX 3000 / EVAL Lua", "TCP Port 6379 (data-net)")
Rel(app_core, db_sqlite, "ACID Read/Write", "POSIX Volume Mount (/data)")
Rel(app_core, bucket_lab, "AES-256-GCM Blob I/O", "POSIX Volume Mount (/data)")

Rel(app_worker, db_sqlite, "Poll Outbox & Notification Queue + Verify Audit", "POSIX Volume Mount (/data)")

Rel(app_core, his_dn, "Sync Appointment", "HTTP Port 8001 (his-net)")
Rel(app_core, his_hue, "Sync Appointment (Circuit Breaker Protected)", "HTTP SOAP Port 8002 (his-net)")
Rel(app_core, his_qn, "Sync Appointment", "HTTP Port 8003 (his-net)")
Rel(app_worker, his_hue, "Rate-Controlled Outbox Replay (+Jitter)", "HTTP SOAP Port 8002 (his-net)")

SHOW_LEGEND()
@enduml
