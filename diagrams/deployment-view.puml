@startuml Deployment_View_MediLink
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Deployment.puml

LAYOUT_WITH_LEGEND()

title Deployment Diagram - Môi trường Chuẩn Docker Compose (MediLink Platform)

Deployment_Node(user_env, "Client Devices", "Trình duyệt & Di động") {
    Deployment_Node(browser, "Web Browser / Mobile App") {
        Container(client_app, "Frontend Application", "Single Page App", "Giao diện người dùng HTTPS")
    }
}

Deployment_Node(cloud_host, "Cloud Host / Server Machine (Linux / Windows)", "Docker Host Engine") {

    Deployment_Node(dmz_net, "DMZ Network (172.20.0.0/24)", "Public Subnet") {
        Deployment_Node(nginx_node, "Reverse Proxy Container", "Docker Container") {
            Container(nginx_proxy, "Nginx Ingress Proxy", "Nginx 1.25", "SSL Termination TLS 1.3, Rate Limiting Token Bucket, Ports 80 & 443")
        }
    }

    Deployment_Node(app_net, "Internal App Network (172.21.0.0/24)", "Private Subnet") {
        Deployment_Node(core_node, "MediLink Core Container", "Docker Container") {
            Container(core_app, "MediLink Backend App", "Node.js 20 LTS", "Cung cấp REST APIs, Auth ABAC, Booking Logic, ACL Engine")
        }
        Deployment_Node(worker_node, "Background Worker Container", "Docker Container") {
            Container(worker_app, "Notification Worker", "Node.js 20 LTS", "Quét lịch và gửi SMS/Zalo/Email từ hàng đợi BullMQ")
        }
    }

    Deployment_Node(data_net, "Isolated Data Network (172.22.0.0/24)", "Database Subnet (No Public IP)") {
        Deployment_Node(pg_node, "Database Container", "Docker Container") {
            ContainerDb(pg_db, "PostgreSQL Database", "PostgreSQL 16", "Lưu trữ dữ liệu quan hệ, UNIQUE slot, bảng Audit HMAC Append-only")
        }
        Deployment_Node(redis_node, "In-Memory Store Container", "Docker Container") {
            ContainerDb(redis_db, "Redis Cluster / Standalone", "Redis 7.2", "Quản lý Distributed Locks, Idempotency Cache, Circuit Breaker State")
        }
    }

    Deployment_Node(his_net, "Mock HIS Network (172.23.0.0/24)", "Subnet Giả lập Cơ sở") {
        Deployment_Node(his_dn_node, "Mock HIS Đà Nẵng Container", "Docker Container") {
            Container(mock_dn, "Mock HIS Đà Nẵng", "Node.js / WireMock", "Cổng REST JSON Service (Port 8001)")
        }
        Deployment_Node(his_hue_node, "Mock HIS Huế Container", "Docker Container") {
            Container(mock_hue, "Mock HIS Huế", "Node.js / WireMock", "Cổng SOAP XML Service (Port 8002)")
        }
        Deployment_Node(his_qn_node, "Mock HIS Quảng Nam Container", "Docker Container") {
            Container(mock_qn, "Mock HIS Quảng Nam", "Node.js / WireMock", "Cổng Custom REST Service (Port 8003)")
        }
    }
}

Rel(client_app, nginx_proxy, "Giao tiếp an toàn", "HTTPS / Port 443 (TLS 1.3)")
Rel(nginx_proxy, core_app, "Reverse Proxy", "HTTP / Port 3000")

Rel(core_app, redis_db, "Distributed Locks & Cache", "TCP / Port 6379")
Rel(core_app, pg_db, "SQL Queries & Transactions", "TCP / Port 5432")
Rel(worker_app, redis_db, "Poll Notification Queue", "TCP / Port 6379")

Rel(core_app, mock_dn, "Sync Appointment [REST JSON]", "HTTP / Port 8001")
Rel(core_app, mock_hue, "Sync Appointment [SOAP XML]", "HTTP / Port 8002")
Rel(core_app, mock_qn, "Sync Appointment [Custom REST]", "HTTP / Port 8003")

@enduml
